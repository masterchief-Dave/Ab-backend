model Blog {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  content       Json
  tags          String[]
  blogPublicId  String?
  blogSecureUrl String?
  authorId      String
  likesCount    Int      @default(0)
  isPublished   Boolean  @default(true)

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  blogLikes BlogLike[]

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BlogsDeletedBy", fields: [deletedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([slug])
  @@index([createdAt])
}
