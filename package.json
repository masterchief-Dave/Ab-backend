{
  "name": "express-postgres-template",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bunx prisma generate && prisma migrate deploy && bun build ./src/server.ts --outdir=dist --minify --target=bun && npx cpy \"src/templates/**\" \"dist/templates\" --parents",
    "start": "bun seed:super-admin && bun run dist/server.js",
    "typecheck": "tsc --noEmit",
    "dev": "bunx prisma generate && bun run typecheck && nodemon --watch ./src --ext ts --exec bun run ./src/server.ts | pino-pretty",
    "lint": "bunx eslint \"src/**/*.{ts,tsx}\"",
    "db": "npx prisma generate --watch",
    "lint:fix": "eslint . --ext ts --fix",
    "seed:super-admin": "exit 0",
    "gen": "bun run src/scripts/create-module.ts",
    "studio": "bunx --bun prisma studio",
    "format": "bunx --bun prisma format"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/otp-generator": "^4.0.2",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "cpy-cli": "^6.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-no-commented-code": "^1.0.10",
    "nodemon": "^3.1.11",
    "prisma": "^7.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@bull-board/api": "^6.20.3",
    "@bull-board/express": "^6.20.3",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^7.0.9",
    "bullmq": "^5.70.4",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.2.1",
    "fs-extra": "^11.3.3",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.13",
    "otp-generator": "^4.0.1",
    "pg": "^8.18.0",
    "pg-boss": "^12.8.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
